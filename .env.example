# Copy to .env (gitignored). Never commit real values.
NODE_ENV=development
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000
# memory (no credentials needed) | firestore
REPO_DRIVER=memory
FIREBASE_PROJECT_ID=qroove-sataklela
# base64 of .secrets/firebase-sa.json (prod) — locally you may instead set GOOGLE_APPLICATION_CREDENTIALS=.secrets/firebase-sa.json
FIREBASE_SERVICE_ACCOUNT_B64=
# set when using the emulator, e.g. 127.0.0.1:8080
FIRESTORE_EMULATOR_HOST=
COOKIE_SECRET=change-me-32-bytes
CRON_SECRET=change-me
# Spotify Web API (optional; app degrades to oEmbed without them)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Registered redirect URI: ${PUBLIC_BASE_URL}/api/spotify/callback
