{
  "name": "qroove",
  "private": true,
  "version": "0.0.0",
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @qroove/server --filter @qroove/web dev",
    "build": "pnpm -r --workspace-concurrency=1 build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "pnpm -r test",
    "test:integration": "pnpm --filter @qroove/server test:integration",
    "test:e2e": "echo \"e2e arrives in Phase 8\"",
    "docs:dev": "pnpm --filter @qroove/docs dev",
    "docs:build": "pnpm --filter @qroove/docs build"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vitest": "4.1.12"
  }
}
